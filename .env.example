# Copy this file to .env, then run npm run setup to create a random session secret.
# Demo works without Google or a running database at http://localhost:3000/demo.
DATABASE_URL="postgresql://wattwise:wattwise_local@localhost:5432/wattwise?schema=public"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET=""

# Create a Web application OAuth client in Google Cloud Console.
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Optional. Keys stay on the server. Enables source lookup and AI explanations.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4.1"

# Optional. Your app contact email or website for Nominatim's User-Agent.
# Without this, users can still enter their location manually.
GEOCODING_CONTACT=""
